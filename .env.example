# Copia a .env (raíz del monorepo)

APP_NAME=MyApp
APP_DESCRIPTION=Full-stack starter
APP_VERSION=0.0.0
APP_AUTHOR=

FRONTEND_PORT=5173
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0

# --- Microsoft SQL Server ---
# Ejemplo con Docker de este repo (perfil local-db, puerto host 14333):
#   DB_HOST=localhost  DB_PORT=14333  DB_USER=sa  DB_PASSWORD=<la misma que MSSQL_SA_PASSWORD>
# Ejemplo con tu contenedor sqlserver-dev en 1433:
#   DB_HOST=localhost  DB_PORT=1433  DB_USER=sa  DB_PASSWORD=<tu contraseña sa>
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_NAME=app_dev

# Conexión segura (Azure / producción suele requerir encrypt=true)
DB_ENCRYPT=false
# En desarrollo local suele ser true (certificado autofirmado del contenedor)
DB_TRUST_SERVER_CERTIFICATE=true

NODE_ENV=development

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

API_BASE_URL=http://localhost:3001
