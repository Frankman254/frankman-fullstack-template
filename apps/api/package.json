{
	"name": "@fullstack-starter/api",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc",
		"db:schema": "tsx src/db/run-schema.ts",
		"start": "node dist/server.js",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"**/*.{ts,js,json,md}\"",
		"format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
		"type-check": "tsc --noEmit",
		"clean": "rimraf dist"
	},
	"dependencies": {
		"@fullstack-starter/shared": "*",
		"cors": "^2.8.5",
		"dotenv": "^17.2.2",
		"express": "^4.21.1",
		"helmet": "^8.0.0",
		"mssql": "^11.0.1"
	},
	"devDependencies": {
		"@types/mssql": "^9.1.5",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/node": "^22.10.2",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-prettier": "^5.5.4",
		"prettier": "^3.7.3",
		"tsx": "^4.19.2",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.39.1",
		"rimraf": "^6.0.1"
	}
}
